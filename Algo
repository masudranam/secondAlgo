}

//sparse table initialization
void init(){
lcadfs(1,-1);
for(int j=1;j<20;j++){
    for(int i=1;i<=N;i++){
        if(table[i][j-1]!=-1){
            int par=table[i][j-1];
            table[i][j]=table[par][j-1];
        }
    }
}
}


int LCA(int a,int b){
if(level[a]>level[b])swap(a,b);
int d=level[b]-level[a];
while(d){
    int i=log2(d);
    b=table[b][i];
    d-=(1<<i);
}
if(a==b)return a;
for(int i=20;i>=0;i--){
    if(table[a][i]!=-1&& (table[a][i]!=table[b][i])){
        a=table[a][i],b=table[b][i];
    }
}
return p[a];
}


 bool bridge(int u,int p=-1){
     vis[u]=1;
     in[u]=low[u]=t++;
     for(auto v:adj[u]){
        if(v==p)continue;
        if(vis[v]){
            low[u]=min(low[u],in[v]);
        } else{
        if(bridge(v,u))return true;
        if(low[v]>in[u])return true;
        low[u]=min(low[v],low[u]);
        }
     }
     return false;
 }


